<!-- views/layout.njk -->
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'DW3 Frontend' }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="app-shell">
  {% if showNavbar %}
    <nav class="navbar navbar-expand-md navbar-dark bg-dark app-navbar shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-semibold" href="/home">DW3 Frontend</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegação">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto mb-2 mb-md-0 gap-md-2">
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'alunos' %}active{% endif %}" href="/alunos">Alunos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link {% if activeMenu == 'cursos' %}active{% endif %}" href="/cursos">Cursos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/login">Sair</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  {% endif %}

  <main class="app-main">
    <div class="container py-4 py-lg-5">
      {% block content %}{% endblock %}
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
