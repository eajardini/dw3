{% extends "layout.njk" %}


{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de alunos</h1>
    <p class="text-secondary mb-0">Manipule os dados cadastrais dos alunos.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados do aluno</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um aluno.</p>
        </div>
      </div>

      <form id="frmAlunos" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="alunoid" name="alunoid" value="0">
        <input type="hidden" id="deleted" name="deleted" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label for="prontuario" class="form-label">Prontuario</label>
            <input type="text" class="form-control" id="prontuario" name="prontuario" value="" required>
          </div>

          <div class="col-12 col-md-8">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" value="" required>
          </div>

          <div class="col-12">
            <label for="endereco" class="form-label">Endereco</label>
            <input type="text" class="form-control" id="endereco" name="endereco" value="" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="rendafamiliar" class="form-label">Renda Familiar</label>
            <input type="number" class="form-control" id="rendafamiliar" name="rendafamiliar" min="0" step="0.01" value="" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="datanascimento" class="form-label">Data Nascimento</label>
            <input type="date" class="form-control" id="datanascimento" name="datanascimento" value="" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="cursoid" class="form-label">Curso</label>
            <select class="form-select" id="cursoid" name="cursoid" required>
              <option value="">Selecione um curso</option>
            </select>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary" id="btnInserirAluno">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning" id="btnAtualizarAluno">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger" id="btnRemoverAluno">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/alunos" id="btnFecharAluno">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script>
    $(function () {
      $('#cursoid').select2({
        theme: 'bootstrap-5',
        placeholder: 'Selecione um curso',
        width: '100%'
      });
    });
  </script>
{% endblock %}
