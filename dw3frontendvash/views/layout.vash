<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(model.title || 'DW3 Frontend')</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="app-shell">
  @if (model.showNavbar) {
    <nav class="navbar navbar-expand-md navbar-dark bg-dark app-navbar shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-semibold" href="/home">DW3 Frontend</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegação">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto mb-2 mb-md-0 gap-md-2">
            <li class="nav-item">
              <a class="nav-link @(model.activeMenu === 'alunos' ? 'active' : '')" href="/alunos">Alunos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(model.activeMenu === 'cursos' ? 'active' : '')" href="/cursos">Cursos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/sair">Sair</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  }

  <main class="app-main">
    <div class="container py-4 py-lg-5">
      @html.block('content')
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/jquery@@4.0.0-rc.1/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
